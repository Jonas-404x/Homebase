{
  "name": "@mainframe/desktop",
  "private": true,
  "main": "main.cjs",
  "type": "commonjs",
  "version": "0.1.0",
  "description": "Native Windows window and tray for the Mainframe web cockpit",
  "author": "Mainframe",
  "scripts": {
    "prestart": "node scripts/copy-icon.cjs",
    "start": "electron .",
    "predist": "node scripts/copy-icon.cjs",
    "dist": "electron-builder --win nsis",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.mainframe.desktop",
    "productName": "Mainframe",
    "icon": "../../assets/brand/logo-512.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "address.cjs",
      "offline.html",
      "icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mainframe"
    }
  }
}
